NEWS_API_KEY=your_newsapi_key_here

# ─── Vercel serverless functions (server-side ONLY) ─────────────────────────
# These are never prefixed with VITE_ and therefore never bundled by Vite.
# Add them in the Vercel dashboard: Project > Settings > Environment Variables.

# Your Supabase project URL (Supabase Dashboard > Settings > API > Project URL)
SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key (used server-side for auth sign-in only)
# Supabase Dashboard > Settings > API > anon public
SUPABASE_ANON_KEY=eyJhbGc...

# Supabase service_role key — full DB access, bypasses RLS.
# NEVER expose this to the browser. Vercel server env vars ONLY.
# Supabase Dashboard > Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...